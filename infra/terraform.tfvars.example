# AWS Region and Environment
aws_region  = "us-east-1"
environment = "Prod"

# VPC Configuration
vpc_name        = "atos-vpc"
vpc_cidr        = "10.0.0.0/16"
azs             = ["us-east-1a", "us-east-1b", "us-east-1c"]
private_subnets = ["10.0.1.0/24", "10.0.2.0/24", "10.0.3.0/24"]
public_subnets  = ["10.0.101.0/24", "10.0.102.0/24", "10.0.103.0/24"]

# EKS Cluster Configuration
cluster_name    = "atos-eks-cluster"
cluster_version = "1.36"
ami_type        = "AL2023_x86_64_STANDARD"
instance_types  = ["c7i-flex.large"]
min_size        = 2
max_size        = 4
desired_size    = 3

# Bastion Host Configuration
bastion_instance_type = "t3.micro"

# Optional: IAM Role ARN to assume dynamically via STS (Leave commented for direct credentials)
# terraform_role_arn = "arn:aws:iam::123456789012:role/JenkinsTerraformRole"
